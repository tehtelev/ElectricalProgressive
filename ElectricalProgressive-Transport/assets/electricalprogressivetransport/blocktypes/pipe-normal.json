{
  "code": "pipe-normal",
  "class": "BlockPipe",
  "entityClass": "BEPipe",
  "variantgroups": [
    {
      "code": "type",
      "states": [
        "straight-ns", "straight-ew", "straight-ud",
        "corner-ne", "corner-se", "corner-sw", "corner-nw",
        "corner-nu", "corner-su", "corner-eu", "corner-wu",
        "corner-nd", "corner-sd", "corner-ed", "corner-wd",
        "tee-n", "tee-e", "tee-s", "tee-w", "tee-u", "tee-d",
        "triple-neu", "triple-seu", "triple-swu", "triple-nwu",
        "triple-ned", "triple-sed", "triple-swd", "triple-nwd",
        "cross"
      ]
    }
  ],
  "drawType": "JSON",
  "emitSideAo": {
    "all": false
  },
  "sideAo": {
    "all": false
  },
  "sideOpaque": {
    "all": false
  },
  "sideSolid": {
    "all": false
  },
  "shapeByType": {
    // === ПРЯМЫЕ ТРУБЫ ===
    "*-straight-ns": { "base": "block/pipe/straight", "rotateY": 90 },
    "*-straight-ew": { "base": "block/pipe/straight", "rotateY": 0 },
    "*-straight-ud": { "base": "block/pipe/vertical", "rotateY": 0 },

    // === ГОРИЗОНТАЛЬНЫЕ УГЛЫ ===
    // Базовая модель corner при rotateY: 0 = Северо-Запад (NW)
    "*-corner-ne": { "base": "block/pipe/corner", "rotateY": 0 },
    "*-corner-se": { "base": "block/pipe/corner", "rotateY": -90 },
    "*-corner-sw": { "base": "block/pipe/corner", "rotateY": 180 },
    "*-corner-nw": { "base": "block/pipe/corner", "rotateY": 90 },

    // === ВЕРТИКАЛЬНЫЕ УГЛЫ (ВВЕРХ) ===
    // Вертикальные углы: поворачиваем базовую модель вверх
    "*-corner-nu": { "base": "block/pipe/corner", "rotateX": 90,"rotateZ": -90, "rotateY": 0 },
    "*-corner-su": { "base": "block/pipe/corner", "rotateX": -90,"rotateZ": -90, "rotateY": 180 },
    "*-corner-eu": { "base": "block/pipe/corner", "rotateX": -90, "rotateY": -90 },//+
    "*-corner-wu": { "base": "block/pipe/corner", "rotateZ": 90, "rotateY": 90 },//+

    // === ВЕРТИКАЛЬНЫЕ УГЛЫ (ВНИЗ) ===
    "*-corner-nd": { "base": "block/pipe/corner", "rotateX": -90,"rotateZ": 90, "rotateY": 0 },
    "*-corner-sd": { "base": "block/pipe/corner", "rotateX": -90,"rotateZ": 270, "rotateY": 0  },
    "*-corner-ed": { "base": "block/pipe/corner", "rotateX": 90, "rotateY": 270 }, 
    "*-corner-wd": { "base": "block/pipe/corner", "rotateX": 180,"rotateZ": 90, "rotateY": 90 }, 

    // === Т-ОБРАЗНЫЕ (ГОРИЗОНТАЛЬНЫЕ) ===
    // Базовая модель tee при rotateY: 0 = "Ножка" на Север
    "*-tee-n": { "base": "block/pipe/tee", "rotateY": 180 },
    "*-tee-e": { "base": "block/pipe/tee", "rotateY": 90 },
    "*-tee-s": { "base": "block/pipe/tee", "rotateY": 0 },
    "*-tee-w": { "base": "block/pipe/tee", "rotateY": 270 },

    // === Т-ОБРАЗНЫЕ (ВЕРТИКАЛЬНЫЕ) ===
    "*-tee-u": { "base": "block/pipe/tee", "rotateX": 270, "rotateY": 0 },
    "*-tee-d": { "base": "block/pipe/tee", "rotateX": 90, "rotateY": 0 },

    // === ТРОЙНЫЕ УГЛОВЫЕ СОЕДИНЕНИЯ (ВВЕРХ) ===
    // Север-Восток-Вверх (треугольник в положительном квадранте XZ, смотрящий вверх)  +
    "*-triple-neu": {
      "base": "block/pipe/triple",
      "rotateY": 0
    },
    // Восток-Юг-Вверх (поворачиваем на 90°)
    "*-triple-seu": {"base": "block/pipe/triple","rotateY": -90},
    // Юг-Запад-Вверх (поворачиваем на 180°)  +
    "*-triple-swu": {"base": "block/pipe/triple","rotateY": 180},
    // Запад-Север-Вверх (поворачиваем на 270°)
    "*-triple-nwu": {"base": "block/pipe/triple","rotateY": 90},

    // === ТРОЙНЫЕ УГЛОВЫЕ СОЕДИНЕНИЯ (ВНИЗ) ===
    // Север-Восток-Вниз (треугольник в положительном квадранте XZ, смотрящий вниз)
    "*-triple-ned": {
      "base": "block/pipe/triple",
      "rotateX": -90,
      "rotateY": 0
    },
    // Восток-Юг-Вниз (поворачиваем на 90°)
    "*-triple-sed": {
      "base": "block/pipe/triple",
      "rotateX": 90,
      "rotateY": -90
    },
    // Юг-Запад-Вниз (поворачиваем на 180°)
    "*-triple-swd": {
      "base": "block/pipe/triple",
      "rotateX": 90,
      "rotateY": 180
    },
    // Запад-Север-Вниз (поворачиваем на 270°)
    "*-triple-nwd": {
      "base": "block/pipe/triple",
      "rotateX": -90,
      "rotateY": 90
    },

    // === КРЕСТОВИНА ===
    "*-cross": { "base": "block/pipe/cross" }
  }
}