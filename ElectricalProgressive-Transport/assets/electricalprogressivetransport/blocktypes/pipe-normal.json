      "base": "block/pipe/corner",
      "rotateX": 90,
      "rotateZ": -90,
      "rotateY": 0
    },
    "*-corner-su": {
      "base": "block/pipe/corner",
      "rotateX": -90,
      "rotateZ": -90,
      "rotateY": 180
    },
    "*-corner-eu": {
      "base": "block/pipe/corner",
      "rotateX": -90,
      "rotateY": -90
    },
    "*-corner-wu": {
      "base": "block/pipe/corner",
      "rotateZ": 90,
      "rotateY": 90
    },
    "*-corner-nd": {
      "base": "block/pipe/corner",
      "rotateX": -90,
      "rotateZ": 90,
      "rotateY": 0
    },
    "*-corner-sd": {
      "base": "block/pipe/corner",
      "rotateX": -90,
      "rotateZ": 270,
      "rotateY": 0
    },
    "*-corner-ed": {
      "base": "block/pipe/corner",
      "rotateX": 90,
      "rotateY": 270
    },
    "*-corner-wd": {
      "base": "block/pipe/corner",
      "rotateX": 180,
      "rotateZ": 90,
      "rotateY": 90
    },

    // === Т-ОБРАЗНЫЕ СОЕДИНЕНИЯ ===
    "*-tee-n": {
      "base": "block/pipe/tee",
      "rotateY": 180,
      "rotateX": 180
    },
