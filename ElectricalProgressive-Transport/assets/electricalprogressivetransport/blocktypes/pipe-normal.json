    "*-tee-un": {
      "base": "block/pipe/tee",
      "rotateX": 90,
      "rotateY": 0,
      "rotateZ": 90
    },
    "*-tee-uw": {
      "base": "block/pipe/tee",
      "rotateY": 0,
      "rotateX": 90,
      "rotateZ": 0
    },
    "*-tee-dn": {
      "base": "block/pipe/tee",
      "rotateY": 0,
      "rotateX": 270,
      "rotateZ": 90
    },
    "*-tee-dw": {
      "base": "block/pipe/tee",
      "rotateY": 0,
      "rotateX": 270
    },
    //ГОРИЗОНТАЛЬНЫЕ Т с вертикальной линией (4 типа) - ножка горизонтальная, линия вертикальная
    "*-tee-nh": {
      "base": "block/pipe/tee",
      "rotateY": 0,
      "rotateZ": 90
    },
    "*-tee-eh": {
      "base": "block/pipe/tee",
      "rotateY": 270,
      "rotateZ": 90
    },
    "*-tee-sh": {
      "base": "block/pipe/tee",
      "rotateX": 180,
      "rotateZ": 90
    },
    "*-tee-wh": {
      "base": "block/pipe/tee",
      "rotateY": 90,
      "rotateZ": 90
    },

    // === ТРОЙНЫЕ УГЛЫ ===
    "*-triple-neu": {
      "base": "block/pipe/triple",
      "rotateY": 0
    },
    "*-triple-seu": {
      "base": "block/pipe/triple",
      "rotateY": -90
    },
    "*-triple-swu": {
      "base": "block/pipe/triple",
      "rotateY": 180
    },
    "*-triple-nwu": {
      "base": "block/pipe/triple",
      "rotateY": 90
    },
    "*-triple-ned": {
      "base": "block/pipe/triple",
      "rotateX": -90,
      "rotateY": 0
    },
    "*-triple-sed": {
      "base": "block/pipe/triple",
      "rotateX": 90,
      "rotateY": -90
    },
    "*-triple-swd": {
      "base": "block/pipe/triple",
      "rotateX": 90,
      "rotateY": 180
    },
    "*-triple-nwd": {
      "base": "block/pipe/triple",
      "rotateX": -90,
      "rotateY": 90
    },

    // === 4 СОЕДИНЕНИЯ (ОТСУТСТВУЕТ 1 СТОРОНА) ===
    // Отсутствует одна горизонтальная сторона
    "*-four-n": {
      "base": "block/pipe/four",
      "rotateY": 0
    }, // Отсутствует север
    "*-four-e": {
      "base": "block/pipe/four",
      "rotateY": 90
    }, // Отсутствует восток
    "*-four-s": {
      "base": "block/pipe/four",
      "rotateY": 180
    }, // Отсутствует юг
    "*-four-w": {
      "base": "block/pipe/four",
      "rotateY": 270
    }, // Отсутствует запад

    // Отсутствует вертикальная сторона (все 4 горизонтальных)
    "*-four-u": {
      "base": "block/pipe/four",
      "rotateZ": 90
    }, // Отсутствует верх
    "*-four-v": {
      "base": "block/pipe/four",
      "rotateX": 90
    }, // Отсутствует верх
    "*-four-d": {
      "base": "block/pipe/four",
      "rotateY": 0
    }, // Отсутствует низ

    // === 4 СОЕДИНЕНИЯ (ОТСУТСТВУЮТ 2 СМЕЖНЫЕ СТОРОНЫ) ===
    // Отсутствуют две смежные горизонтальные стороны
    "*-four-nw": {
      "base": "block/pipe/diagonal",
      "rotateY": 270
    }, // Отсутствуют север и запад
    "*-four-ne": {
      "base": "block/pipe/diagonal",
      "rotateY": 180
    }, // Отсутствуют север и восток
    "*-four-sw": {
      "base": "block/pipe/diagonal",
      "rotateY": 0
    }, // Отсутствуют юг и запад
    "*-four-se": {
      "base": "block/pipe/diagonal",
      "rotateY": 90
    }, // Отсутствуют юг и восток

    // Отсутствует горизонтальная + вертикальная сверху
    "*-four-nu": {
      "base": "block/pipe/diagonal",
      "rotateY": 180,
      "rotateZ": -90
    }, // Отсутствуют север и верх
    "*-four-su": {
      "base": "block/pipe/diagonal",
      "rotateY": 0,
      "rotateZ": -90
    }, // Отсутствуют юг и верх
    "*-four-eu": {
      "base": "block/pipe/diagonal",
      "rotateY": 90,
      "rotateX": -90,
      "rotateZ": 0
    }, // Отсутствуют восток и верх
    "*-four-wu": {
      "base": "block/pipe/diagonal",
      "rotateY": 0,
      "rotateX": -90
    }, // Отсутствуют запад и верх

    // Отсутствует горизонтальная + вертикальная снизу
    "*-four-nd": {
      "base": "block/pipe/diagonal",
      "rotateY": 0,
      "rotateX": 90,
      "rotateZ": 90
    }, // Отсутствуют север и низ
    "*-four-sd": {
      "base": "block/pipe/diagonal",
      "rotateY": 0,
      "rotateZ": 90
    }, // Отсутствуют юг и низ
    "*-four-ed": {
      "base": "block/pipe/diagonal",
      "rotateY": -180,
      "rotateX": -90
    }, // Отсутствуют восток и низ
    "*-four-wd": {
      "base": "block/pipe/diagonal",
      "rotateY": 270,
      "rotateX": -90
    }, // Отсутствуют запад и низ

    // === 5 СОЕДИНЕНИЙ ===
    "*-five-n": {
      "base": "block/pipe/five",
      "rotateY": 270
    }, // Отсутствует север
    "*-five-e": {
      "base": "block/pipe/five",
      "rotateY": 180
    }, // Отсутствует восток
    "*-five-s": {
      "base": "block/pipe/five",
      "rotateY": 90
    }, // Отсутствует юг
    "*-five-w": {
      "base": "block/pipe/five",
      "rotateY": 0
    }, // Отсутствует запад
    "*-five-u": {
      "base": "block/pipe/five",
      "rotateZ": -90,
      "rotateY": 0
    }, // Отсутствует верх
    "*-five-d": {
      "base": "block/pipe/five",
      "rotateZ": 90,
      "rotateY": 0
    }, // Отсутствует низ

    // === КРЕСТОВИНА ===
    "*-cross": {
      "base": "block/pipe/cross",
      "rotateY": 0
    }
  }

  // Пояснения:
  // 1. four-n/e/s/w/u/d: отсутствует ОДНА сторона (5 соединений фактически)
  // 2. four-nw/ne/sw/se: отсутствуют ДВЕ смежные горизонтальные стороны (угловые)
  // 3. four-nu/su/eu/wu: отсутствует горизонтальная сторона + верх
  // 4. four-nd/sd/ed/wd: отсутствует горизонтальная сторона + низ
  //
  // Для работы с этими моделями нужно создать соответствующие .json модели в assets:
  // - block/pipe/four-horizontal.json (все 4 горизонтальных соединения)
  // - block/pipe/four-diagonal.json (2 противоположных горизонтальных + 2 вертикальных)
  // - block/pipe/four-corner-up.json (3 соединения в форме угла смотрящего вверх)
  // - block/pipe/four-corner-down.json (3 соединения в форме угла смотрящего вниз)
}