      "base": "block/pipe/tee",
      "rotateY": 90
    },
    "*-tee-s": {
      "base": "block/pipe/tee",
      "rotateX": 180
    },
    "*-tee-w": {
      "base": "block/pipe/tee",
      "rotateY": 270
    },
