<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
        <Nullable>enable</Nullable>
        <RootNamespace>ElectricalProgressive</RootNamespace>
    </PropertyGroup>
    <!-- Папки машин видят типы друг друга. ImplicitUsings не включаем: System подключается в файле, где он нужен. -->
    <ItemGroup>
        <Using Include="ElectricalProgressive.Content.Storage" />
        <Using Include="ElectricalProgressive.Content.Storage.Assembler" />
        <Using Include="ElectricalProgressive.Content.Storage.Bus" />
        <Using Include="ElectricalProgressive.Content.Storage.Cable" />
        <Using Include="ElectricalProgressive.Content.Storage.Controller" />
        <Using Include="ElectricalProgressive.Content.Storage.Craft" />
        <Using Include="ElectricalProgressive.Content.Storage.Drive" />
        <Using Include="ElectricalProgressive.Content.Storage.Gui" />
        <Using Include="ElectricalProgressive.Content.Storage.Interface" />
        <Using Include="ElectricalProgressive.Content.Storage.IoPort" />
        <Using Include="ElectricalProgressive.Content.Storage.Patch" />
        <Using Include="ElectricalProgressive.Content.Storage.Pattern" />
        <Using Include="ElectricalProgressive.Content.Storage.Processor" />
        <Using Include="ElectricalProgressive.Content.Storage.Terminal" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\ElectricalProgressive-Core\ElectricalProgressive-Core.csproj">
        <Private>false</Private>
      </ProjectReference>
      <ProjectReference Include="..\ElectricalProgressive-Basics\ElectricalProgressive-Basics.csproj">
        <Private>false</Private>
      </ProjectReference>
    </ItemGroup>
    <Import Project="..\build\CopyDependentMods.targets" />
    <ItemGroup>
        <Reference Include="protobuf-net">
            <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Newtonsoft">
            <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Harmony">
            <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VintagestoryAPI">
            <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="cairo-sharp">
            <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SkiaSharp">
            <HintPath>$(VINTAGE_STORY)/Lib/SkiaSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VSSurvivalMod">
            <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Content Include="assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="modinfo.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
